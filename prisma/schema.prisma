// CoachFlow — модель данных.
// Все даты/время хранятся в UTC (timestamptz); отображение — в Europe/Moscow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TRAINER
  CLIENT
}

enum SessionStatus {
  SCHEDULED // запланировано (после начала — ждёт заполнения результатов)
  COMPLETED // проведено, результаты внесены
  CANCELLED // отменено
  MISSED    // клиент не пришёл (отметил тренер)
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               Role
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  trainerProfile TrainerProfile?
  clientProfile  ClientProfile?
  notifications  Notification[]
  pushSubscriptions PushSubscription[]
}

model TrainerProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUsername String?

  clients   ClientProfile[]
  exercises Exercise[]
  sessions  Session[]
}

model ClientProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  heightCm  Int?
  goal      String?
  // Длительность занятия по умолчанию: 60, 75 или 90 минут
  sessionDurationMin Int   @default(90)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  bodyWeights BodyWeightEntry[]
  programs    Program[]
  sessions    Session[]
  notes       ClientNote[]
  nutrition   NutritionTargets?
  records      PersonalRecord[]
  photos       ProgressPhoto[]
  measurements BodyMeasurement[]
  achievements ClientAchievement[]
  memberships  Membership[]

  @@index([trainerId])
}

model BodyWeightEntry {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date     DateTime      @db.Date // календарная дата (по Москве)
  weightKg Float

  @@unique([clientId, date])
}

// Заметки тренера по клиенту (клиенту не показываются)
model ClientNote {
  id        String        @id @default(cuid())
  clientId  String
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([clientId, createdAt])
}

// Справочник упражнений тренера
model Exercise {
  id        String         @id @default(cuid())
  trainerId String
  trainer   TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  name      String

  programItems ProgramExercise[]
  results      SessionResult[]
  records      PersonalRecord[]

  @@unique([trainerId, name])
}

model Program {
  id          String        @id @default(cuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean       @default(false) // у клиента одна текущая программа
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  exercises ProgramExercise[]

  @@index([clientId])
}

model ProgramExercise {
  id         String   @id @default(cuid())
  programId  String
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  dayLabel   String?  // например «День A»
  position   Int
  sets       Int
  reps       String   // «8–10», «12», «до отказа»
  weightKg   Float?
  notes      String?

  @@index([programId, position])
}

// Запись в календаре. После начала превращается в карточку результатов.
model Session {
  id          String         @id @default(cuid())
  trainerId   String
  trainer     TrainerProfile @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  clientId    String
  client      ClientProfile  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  startsAt    DateTime       @db.Timestamptz(3)
  endsAt      DateTime       @db.Timestamptz(3)
  status      SessionStatus  @default(SCHEDULED)
  notes       String?        // заметка тренера по тренировке
  createdById String
  cancelledAt DateTime?      @db.Timestamptz(3)
  cancelledById String?
  // Напоминания (сбрасываются при переносе)
  reminderDaySentAt   DateTime? @db.Timestamptz(3)
  reminderSoonSentAt  DateTime? @db.Timestamptz(3)
  // Клиент подтвердил, что придёт («Приду»). Сбрасывается при переносе.
  confirmedAt DateTime? @db.Timestamptz(3)
  // Черновик результатов, который тренер заполняет во время тренировки (до «Завершить»)
  resultsDraft Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  results          SessionResult[]
  records          PersonalRecord[]
  membershipEntry  MembershipEntry?

  @@index([trainerId, startsAt])
  @@index([clientId, startsAt])
}

// Один выполненный подход
model SessionResult {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setNumber  Int
  weightKg   Float
  reps       Int

  @@index([sessionId])
  @@index([exerciseId])
}

model NutritionTargets {
  id        String        @id @default(cuid())
  clientId  String        @unique
  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  calories  Int
  proteinG  Int
  fatG      Int
  carbsG    Int
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
}

// Уведомление пользователю (колокольчик в приложении + push на телефон)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  url       String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

// Подписка браузера/телефона на push-уведомления (Web Push)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
}

// Служебные настройки приложения (например, ключи VAPID для push)
model AppSetting {
  key   String @id
  value String
}

// Личный рекорд клиента в упражнении (лучший вес, при равном весе — больше повторений)
model PersonalRecord {
  id               String        @id @default(cuid())
  clientId         String
  client           ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  exerciseId       String
  exercise         Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId        String
  session          Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  weightKg         Float
  reps             Int
  previousWeightKg Float?
  previousReps     Int?
  achievedAt       DateTime      @db.Timestamptz(3) // время тренировки
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, exerciseId])
  @@index([clientId, achievedAt])
}

// Фото «до/после». Сам файл хранится вне БД (диск или S3), здесь — только ключ.
model ProgressPhoto {
  id           String        @id @default(cuid())
  clientId     String
  client       ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  takenOn      DateTime      @db.Date
  storageKey   String        @unique
  thumbKey     String        @unique
  width        Int
  height       Int
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([clientId, takenOn])
}

// Замеры тела (вес тела хранится в BodyWeightEntry)
model BodyMeasurement {
  id          String        @id @default(cuid())
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime      @db.Date
  waistCm     Float?
  hipsCm      Float?
  chestCm     Float?
  armCm       Float?
  createdById String
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([clientId, date])
}

// Выданный значок. Правила — в src/lib/achievements.ts
model ClientAchievement {
  id       String        @id @default(cuid())
  clientId String
  client   ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code     String
  earnedAt DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([clientId, code])
}

// Абонемент на N занятий
model Membership {
  id                String        @id @default(cuid())
  clientId          String
  client            ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  totalSessions     Int
  remainingSessions Int
  validFrom         DateTime      @db.Date
  validUntil        DateTime      @db.Date
  paidAt            DateTime?     @db.Timestamptz(3)
  priceRub          Int?
  note              String?
  remindedLowAt     DateTime?     @db.Timestamptz(3) // напомнили «осталось ≤ 2»
  remindedExpiryAt  DateTime?     @db.Timestamptz(3) // напомнили «до конца ≤ 7 дней»
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  entries           MembershipEntry[]

  @@index([clientId, validUntil])
}

// Журнал движений по абонементу: списание за занятие или ручная корректировка
model MembershipEntry {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sessionId    String?    @unique // одно занятие списывается не больше одного раза
  session      Session?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  delta        Int
  reason       String     // session | manual | payment
  note         String?
  createdById  String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([membershipId, createdAt])
}
