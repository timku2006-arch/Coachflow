# Строка подключения к PostgreSQL (совпадает с docker-compose.yml)
DATABASE_URL="postgresql://coachflow:coachflow@localhost:5432/coachflow?schema=public"
# Отдельная БД для тестов — тесты её очищают!
TEST_DATABASE_URL="postgresql://coachflow:coachflow@localhost:5432/coachflow_test?schema=public"
# Секрет для подписи сессионных cookie (минимум 32 символа). Сгенерировать: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Фото прогресса. По умолчанию — папка ./data/uploads на диске сервера.
# UPLOADS_DIR="/app/data/uploads"
# Либо S3-совместимое хранилище (например, Timeweb Cloud S3) — тогда диск не нужен:
# S3_ENDPOINT="https://s3.twcstorage.ru"
# S3_BUCKET="coachflow-photos"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_REGION="ru-1"
